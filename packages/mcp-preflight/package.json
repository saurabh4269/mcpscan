{
  "name": "mcp-preflight",
  "version": "0.1.0",
  "description": "MCP Security Preflight — auth, tool risk, injection scan, directory readiness",
  "type": "module",
  "bin": {
    "mcp-preflight": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist",
    "shared"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:browser",
    "build:browser": "esbuild src/browser.ts --bundle --format=esm --platform=browser --outfile=../../dist/preflight/preflight-browser.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "preflight": "node dist/cli.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
